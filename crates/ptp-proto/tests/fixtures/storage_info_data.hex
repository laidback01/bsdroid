# PTP data container: GetStorageInfo response payload
# Source: Samsung SM-S901U, LIBMTP_DEBUG=9 capture, FreeBSD 15.1-RELEASE-p2.
#
# This fixture is the important one. It holds every scalar width the protocol
# uses, and it holds a PTP string. A parser that reads this container correctly
# reads most of the protocol correctly.

4a000000    # length = 74 (u32 little-endian)
0200        # container type = 2 (Data)
0510        # operation code = 0x1005 (GetStorageInfo)
22000000    # transaction id = 34

# --- StorageInfo dataset starts here ---
0300        # StorageType = 0x0003 (fixed RAM)
0200        # FilesystemType = 0x0002 (generic hierarchical)
0000        # AccessCapability = 0x0000 (read/write)

00303fdd37000000    # MaxCapacity = 239935107072 bytes (u64 little-endian)
0090d1a92f000000    # FreeSpaceInBytes = 204718743552 bytes (u64 little-endian)
00000040            # FreeSpaceInObjects = 1073741824 (u32 little-endian)

# StorageDescription: a PTP string.
# The first byte is the character count, and the count includes the
# terminator. The characters are UTF-16 little-endian.
11                  # 17 characters, which is "Internal storage" plus a null
49006e00740065007200    # I n t e r
6e0061006c002000        # n a l (space)
73007400              # s t
6f00720061006700650000 00   # o r a g e (null)

# VolumeIdentifier: a PTP string.
00                  # 0 characters, an empty string

# Total: 12 header + 6 + 16 + 4 + 35 + 1 = 74. The length field agrees.
