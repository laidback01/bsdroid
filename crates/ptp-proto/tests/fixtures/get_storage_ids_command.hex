# PTP command container: GetStorageIDs
# Source: Samsung SM-S901U, LIBMTP_DEBUG=9 capture, FreeBSD 15.1-RELEASE-p2.

0c000000    # length = 12 (u32 little-endian), the full container
0100        # container type = 1 (Command)
0410        # operation code = 0x1004 (GetStorageIDs)
21000000    # transaction id = 33

# The container carries no parameter. Length 12 equals the header size.
