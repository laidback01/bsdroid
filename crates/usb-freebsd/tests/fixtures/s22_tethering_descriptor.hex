# USB configuration descriptor, Samsung SM-S901U in USB tethering mode.
#
# Source command:
#   usbconfig -d ugen0.11 do_request 0x80 0x06 0x0200 0 256
#
# Device state at the moment of the capture:
#   sys.usb.config      rndis,adb
#   screen              unlocked
#   idProduct           0x6864
#   MTP interface       absent
#
# This capture holds the trap. The CDC-data interface uses endpoint 0x81 and
# endpoint 0x01. Those two addresses carry MTP in the other modes of the same
# phone.
#
# A host that looks for a bulk endpoint pair, and does not check the interface
# class first, opens the network interface here. The host then sends PTP to a
# network device. The class check is not a detail.
#
# FreeBSD names this device "GT-I9070 (network tethering, USB debugging
# enabled)". A GT-I9070 is a Galaxy S Advance from 2012. The name comes from a
# product identifier table in the host, and the name is wrong. Do not use the
# product string to identify a device.

# --- Configuration descriptor ---
09          # bLength = 9
02          # bDescriptorType = 2 (CONFIGURATION)
6a00        # wTotalLength = 106
03          # bNumInterfaces = 3
01          # bConfigurationValue = 1
04          # iConfiguration = 4
80          # bmAttributes
fa          # bMaxPower = 250, which is 500 mA

# --- Interface association: interfaces 0 and 1 form the network function ---
08 0b 00 02 e0 01 03 07

# --- Interface 0: RNDIS control. The class 0xe0 is a wireless controller. ---
09 04 00 00 01 e0 01 03 05
05 24 00 1001         # CDC header
05 24 01 00 01        # CDC call management
04 24 02 00           # CDC abstract control
05 24 06 00 01        # CDC union
07 05 82 03 0800 09   # endpoint 0x82, interrupt, 8 bytes

# --- Interface 1: CDC data. Note the endpoint addresses. ---
09 04 01 00 02 0a 00 00 06
07 05 81 02 0002 00   # endpoint 0x81. MTP uses this address in other modes.
07 05 01 02 0002 00   # endpoint 0x01. MTP uses this address in other modes.

# --- Interface 2: adb ---
09 04 02 00 02 ff 42 01 08
07 05 02 02 0002 00
07 05 83 02 0002 00

# --- A vendor descriptor at the end ---
08 24 80 0c 00 01 00 01

# The lengths add to 106, which agrees with wTotalLength.
