# USB configuration descriptor, Samsung SM-S901U in "Transferring images" mode.
#
# Source command:
#   usbconfig -d ugen0.11 do_request 0x80 0x06 0x0200 0 256
#
# Device state at the moment of the capture:
#   sys.usb.config      ptp,adb
#   screen              unlocked
#   idProduct           0x6866
#   GetStorageIDs       0x2001 OK, 1 storage, on attempt 2
#
# This mode gives file access. The host read the storage, the capacity and the
# free space. See docs/02-device-states.md.
#
# Two fields separate this capture from the file transfer capture:
#   - idProduct is 0x6866 here, and 0x6860 in file transfer mode. The field
#     lives in the device descriptor, and not in this file.
#   - iInterface of interface 0 is 0 here, and 5 in file transfer mode.
#
# The class, the subclass and the protocol are the same in both modes. PTP and
# MTP share the interface class, because MTP is an extension of PTP.

# --- Configuration descriptor ---
09          # bLength = 9
02          # bDescriptorType = 2 (CONFIGURATION)
4600        # wTotalLength = 70
02          # bNumInterfaces = 2
01          # bConfigurationValue = 1
04          # iConfiguration = 4
80          # bmAttributes = 0x80 (bus power)
fa          # bMaxPower = 250, which is 500 mA

# --- Interface 0: still imaging, which carries PTP here ---
09          # bLength = 9
04          # bDescriptorType = 4 (INTERFACE)
00          # bInterfaceNumber = 0
00          # bAlternateSetting = 0
03          # bNumEndpoints = 3
06          # bInterfaceClass = 0x06 (still imaging), the same as MTP
01          # bInterfaceSubClass = 0x01
01          # bInterfaceProtocol = 0x01
00          # iInterface = 0. File transfer mode gives 5 here.

07 05 81 02 0002 00   # endpoint 0x81, bulk, 512 bytes
07 05 01 02 0002 00   # endpoint 0x01, bulk, 512 bytes
07 05 82 03 1c00 06   # endpoint 0x82, interrupt, 28 bytes

# --- Interface 1: adb ---
09 04 01 00 02 ff 42 01 05
07 05 02 02 0002 00
07 05 83 02 0002 00

# --- A vendor descriptor at the end ---
08 24 80 0c 00 01 00 01

# The lengths add to 70, which agrees with wTotalLength.
