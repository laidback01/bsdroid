# USB configuration descriptor, Samsung SM-S901U in MIDI mode.
#
# Source command:
#   usbconfig -d ugen0.11 do_request 0x80 0x06 0x0200 0 256
#
# Device state at the moment of the capture:
#   sys.usb.config      midi,adb
#   screen              unlocked
#   idProduct           0x686c
#   MTP interface       absent
#
# This capture holds two traps.
#
# Trap 1: the endpoint descriptors hold 9 bytes, and not 7. The audio class
# adds two bytes to each endpoint descriptor. A parser that adds 7 to the
# position, in place of the length byte, reads the next descriptor at the wrong
# offset. Every descriptor after the first endpoint is then wrong.
#
# Trap 2: the MIDI streaming interface owns endpoint 0x01 and endpoint 0x81.
# The same two addresses carry MTP in file transfer mode. The tethering capture
# holds the same trap, with a different interface class.
#
# The user reported one more fact. This mode needed no passcode on the phone,
# and file transfer mode did need one.

# --- Configuration descriptor ---
09          # bLength = 9
02          # bDescriptorType = 2 (CONFIGURATION)
8400        # wTotalLength = 132
03          # bNumInterfaces = 3
01          # bConfigurationValue = 1
04          # iConfiguration = 4
80          # bmAttributes
fa          # bMaxPower = 250, which is 500 mA

# --- Interface 0: audio control, and it has no endpoint ---
09          # bLength = 9
04          # bDescriptorType = 4 (INTERFACE)
00          # bInterfaceNumber = 0
00          # bAlternateSetting = 0
00          # bNumEndpoints = 0
01          # bInterfaceClass = 0x01 (audio)
01          # bInterfaceSubClass = 0x01 (audio control)
00          # bInterfaceProtocol = 0
05          # iInterface = 5
09 24 01 00 01 0900 01 01   # class descriptor: audio control header

# --- Interface 1: MIDI streaming ---
09 04 01 00 02 01 03 00 00
07 24 01 00 01 2500         # class descriptor: MIDI streaming header
06 24 02 02 01 00           # MIDI in jack
09 24 03 01 02 01 01 01 00  # MIDI out jack
06 24 02 01 03 00           # MIDI in jack
09 24 03 02 04 01 03 01 00  # MIDI out jack

# Endpoint descriptors of 9 bytes. Note the length byte.
09          # bLength = 9. A standard endpoint descriptor holds 7.
05          # bDescriptorType = 5 (ENDPOINT)
01          # bEndpointAddress = 0x01. MTP uses this address in other modes.
02          # bmAttributes = bulk
0002        # wMaxPacketSize = 512
00          # bInterval
0000        # two more bytes, which the audio class adds
05 25 01 01 03              # class descriptor for the endpoint

09 05 81 02 0002 00 0000    # endpoint 0x81, 9 bytes. MTP uses this address.
05 25 01 01 02              # class descriptor for the endpoint

# --- Interface 2: adb ---
09 04 02 00 02 ff 42 01 07
07 05 02 02 0002 00
07 05 82 02 0002 00

# --- A vendor descriptor at the end ---
08 24 80 0c 00 01 00 01

# The lengths add to 132, which agrees with wTotalLength.
